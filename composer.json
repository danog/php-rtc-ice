{
    "name": "danog/php-rtc-ice",
    "type": "library",
    "description": "WebRTC ICE connectivity in PHP, ported to Amp v3 fibers and sockets. MadelineProto's PHP 8.2+ fork integrates the modular danog/php-rtc STUN, TURN, and mDNS stack.",
    "keywords": [
        "webrtc",
        "ice",
        "turn",
        "stun"
    ],
    "homepage": "https://github.com/danog/php-rtc-ice",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1",
        "amphp/socket": "^2.3",
        "amphp/dns": "^2.4",
        "danog/php-rtc-exception": "^1.0",
        "danog/php-rtc-turn": "^1.1.1",
        "danog/php-rtc-stun": "^1.1.1",
        "danog/php-rtc-mdns": "^1.0",
        "psr/log": "^3.0",
        "symfony/polyfill-php84": "^1.32"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\ICE\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\ICE\\": "tests"
        }
    },
    "minimum-stability": "dev"
}
