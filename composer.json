{
    "name": "danog/php-rtc-ice",
    "type": "library",
    "description": "WebRTC ICE connectivity in PHP, ported to Amp v3 fibers and sockets. MadelineProto's PHP 8.2+ fork integrates the modular danog/php-rtc STUN, TURN, and mDNS stack.",
    "keywords": [
        "webrtc",
        "ice",
        "turn",
        "stun"
    ],
    "homepage": "https://github.com/danog/php-rtc-ice",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1.3",
        "amphp/socket": "^2.4.1",
        "amphp/dns": "^2.4.1",
        "danog/php-rtc-exception": "^1.1.5",
        "danog/php-rtc-turn": "^1.1.7",
        "danog/php-rtc-stun": "^1.1.8",
        "danog/php-rtc-mdns": "^1.1.7",
        "psr/log": "^3.0.2",
        "symfony/polyfill-php84": "*"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.15",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.3.2",
        "bamarni/composer-bin-plugin": "^1.9.1"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\ICE\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\ICE\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
